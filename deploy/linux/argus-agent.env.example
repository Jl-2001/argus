# Argus agent environment file -- TEMPLATE.
#
# This file is read by systemd's EnvironmentFile= (see
# argus-agent.service.example) or can be `source`d/exported manually.
# It is loaded by argus.agent.config.load_agent_config -- see that
# module's own docstring for what each variable does and how
# ARGUS_AGENT_TOKEN is handled once read (kept only in the agent
# process's memory, attached as a Bearer header, never logged).
#
# --------------------------------------------------------------
# DO NOT commit a filled-in copy of this file to git, anywhere.
# DO NOT store it inside this repository at all -- keep the real
#   file outside the working tree (e.g. ~/.config/argus/argus-agent.env)
#   so an accidental `git add -A` cannot pick it up.
# chmod the real file 600 (owner read/write only):
#   chmod 600 ~/.config/argus/argus-agent.env
# The token below is a secret Argus's control plane can only show you
#   ONCE, at `argus agents add` time (see README.md's "Multi-host
#   monitoring" section) -- the control plane itself only ever
#   persists a hash of it, never the raw value.
# --------------------------------------------------------------

# Printed once by `argus agents add <host-key> --name "<display name>"`
# on the control plane. Copy both values from that output.
ARGUS_AGENT_ID=<agent-id>
ARGUS_AGENT_TOKEN=<secret-token>

# Must match the host key you registered with `argus agents add`.
# Stable identity for this machine -- do not change it later without
# re-registering, or the control plane will treat it as a new host.
ARGUS_HOST_KEY=<stable-host-key>

# Optional; defaults to ARGUS_HOST_KEY if omitted. Purely cosmetic --
# what the dashboard/CLI display for this host.
ARGUS_HOST_NAME=<display-name>

# Where this agent sends its POST /api/v1/agents/ingest snapshots.
# In this deployment's SSH-reverse-tunnel topology, the control plane
# is reachable on this machine's own loopback -- see
# docs/multi-host-deployment.md for why 18088, not 8088.
ARGUS_CONTROL_PLANE_URL=http://127.0.0.1:18088

# Optional; defaults to 15 seconds (argus.agent.config.DEFAULT_POLL_INTERVAL_SECONDS).
# ARGUS_AGENT_POLL_INTERVAL=15
